{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/gen_published_urls.mjs\" --from-hook",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Updating PUBLISHED_PROJECT_URLS.txt"
          }
        ]
      }
    ]
  }
}
