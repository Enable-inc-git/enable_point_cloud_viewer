rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userEmail() {
      return request.auth.token.email.lower();
    }
    function clientData(cid) {
      return get(/databases/$(database)/documents/clients/$(cid)).data;
    }
    function isExplicitMember(cid) {
      return exists(/databases/$(database)/documents/clients/$(cid)/members/$(userEmail()));
    }
    function isDomainMember(cid) {
      return exists(/databases/$(database)/documents/clients/$(cid))
        && ('allowedDomains' in clientData(cid))
        && (userEmail().split('@')[1] in clientData(cid).allowedDomains);
    }
    // A members/'everyone' sentinel doc opens the client to ANY signed-in user.
    function isOpenToEveryone(cid) {
      return exists(/databases/$(database)/documents/clients/$(cid)/members/everyone);
    }
    function isMember(cid) {
      return signedIn() && (isExplicitMember(cid) || isDomainMember(cid) || isOpenToEveryone(cid));
    }
    function accessActive(cid) {
      let c = clientData(cid);
      let grace = duration.value(15, 'd');
      return (('grantUntil' in c) && request.time < c.grantUntil + grace)
        || (('subscriptionStatus' in c) && c.subscriptionStatus == 'active')
        || (('subscriptionStatus' in c) && c.subscriptionStatus == 'trialing')
        || (('subscriptionStatus' in c) && c.subscriptionStatus == 'past_due'
            && ('currentPeriodEnd' in c) && request.time < c.currentPeriodEnd + grace);
    }
    function canUse(cid) {
      return isMember(cid) && accessActive(cid);
    }

    match /clients/{cid} {
      allow read: if isMember(cid);
      allow write: if false;

      match /members/{memberEmail} {
        // A user may read their own member doc, plus the 'everyone' sentinel
        // (so the client can detect open-to-anyone access).
        allow read: if signedIn() && (memberEmail == userEmail() || memberEmail == 'everyone');
        allow write: if false;
      }

      match /signins/{signinEmail} {
        allow read: if false;
        allow create, update: if signedIn() && signinEmail == userEmail() && isMember(cid);
      }

      match /projects/{projectId} {
        allow read: if canUse(cid);
        allow write: if false;
      }
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
